# API keys — copy this file to config/secrets.yaml and fill in your real keys.
# config/secrets.yaml is git-ignored — do NOT commit real keys.

# Volcengine Ark (火山方舟) — video generation (Seedance 2.0, Agent 3).
ark:
  api_key: "your-ark-api-key-here"

# Volcengine Ark (火山方舟) — image generation (Seedream 5.0 Pro, image agent).
# Separate key so image/video token usage can be tracked independently.
# Each Ark model must still be opened (开通) in the Ark console separately.
seedream:
  api_key: "your-seedream-api-key-here"

# Optional fallback provider (future)
# claude:
#   api_key: "sk-ant-..."
